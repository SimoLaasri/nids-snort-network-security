# Network variables from the report's Annex B, not a complete snort.conf.
# Merge the relevant variables into the distribution's full Snort 2 config.
ipvar HOME_NET 192.168.50.0/24
ipvar EXTERNAL_NET !$HOME_NET

ipvar DNS_SERVERS $HOME_NET
ipvar SMTP_SERVERS $HOME_NET
ipvar HTTP_SERVERS 192.168.50.20/32
ipvar SQL_SERVERS $HOME_NET
ipvar TELNET_SERVERS $HOME_NET
ipvar SSH_SERVERS 192.168.50.20/32

var RULE_PATH /etc/snort/rules
var SO_RULE_PATH /etc/snort/so_rules
var PREPROC_RULE_PATH /etc/snort/preproc_rules

# Ensure the full configuration includes $RULE_PATH/local.rules once.
# Keep its packaged rule includes; a community.rules file may not be installed.
